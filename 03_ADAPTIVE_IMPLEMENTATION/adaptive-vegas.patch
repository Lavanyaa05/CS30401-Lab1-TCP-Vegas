+            // Adaptive BaseRTT relearning for persistent upward path-delay shifts.
+            //
+            // A route-induced baseline change should persist across multiple RTT
+            // cycles. Short-lived RTT spikes are ignored.
+            const Time shiftThreshold = MilliSeconds(3);
+            const uint32_t persistenceCycles = 5;
+            const Time resetCooldown = Seconds(10);
+
+            if (m_minRtt > m_baseRtt + shiftThreshold &&
+                (Simulator::Now() - m_lastAdaptiveReset) > resetCooldown)
+            {
+                m_shiftCount++;
+            }
+            else
+            {
+                m_shiftCount = 0;
+            }
+
+            if (m_shiftCount >= persistenceCycles)
+            {
+                const Time oldBaseRtt = m_baseRtt;
+
+                m_baseRtt = m_minRtt;
+                m_shiftCount = 0;
+                m_lastAdaptiveReset = Simulator::Now();
+
+                std::cout
